# Copy to .env and adjust for your platform — see README.md "Backend API URL".
#
# iOS simulator (runs on the same Mac as flashy-api):
EXPO_PUBLIC_API_URL=http://localhost:3001
#
# Android emulator (10.0.2.2 is the emulator's alias for the host Mac):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
#
# Physical device (must be on the same network as your Mac):
# EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:3001
