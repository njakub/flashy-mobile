# Copy to .env and adjust for your platform — see README.md "Backend API URL".
#
# iOS simulator (runs on the same Mac as flashy-api):
EXPO_PUBLIC_API_URL=http://localhost:3001
#
# Android emulator (10.0.2.2 is the emulator's alias for the host Mac):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
#
# Physical device (must be on the same network as your Mac):
# EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:3001

# Crash reporting (optional in dev; set as an EAS env var for release builds).
# Sentry is disabled entirely when unset. Source-map upload at build time
# additionally needs SENTRY_AUTH_TOKEN (EAS secret).
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Google sign-in (see docs/social-auth-api.md). The Google button is hidden
# until the web client id is set. The iOS client id must match the
# iosUrlScheme configured in app.json.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com
